  "site": {
    "attrs": {
      "context": "Portail client B2B d'ACME Distribution : les clients professionnels consultent le catalogue, passent commande et suivent leur compte. Authentification SSO obligatoire, tarifs négociés par client, paiement en ligne ou sur facture.",
      "constraints": [
        "SSO obligatoire (OIDC) pour tout accès authentifié",
        "RGPD : minimisation des données, consentement traçable",
        "Compatibilité navigateurs : 2 dernières versions Chrome/Edge/Firefox/Safari",
        "Accessibilité RGAA AA"
      ],
      "notes": "MVP visé pour le T4. Le catalogue est la brique la plus urgente."
    }
  },
  "services": [
    {
      "id": "cf4c30a8-de84-4a07-b2cb-c52c3eb77d27",
      "name": "ERP SAP (produits & commandes)",
      "baseUrl": "https://erp.acme-b2b.com/api/v2",
      "auth": "OAuth2 client_credentials",
      "risk": "high",
      "endpoints": [
        {
          "method": "GET",
          "path": "/products",
          "notes": "Catalogue paginé (100/page), tarifs par client via header X-Customer-Id"
        },
        {
          "method": "GET",
          "path": "/products/{sku}",
          "notes": "Fiche produit détaillée"
        },
        {
          "method": "GET",
          "path": "/stock/{sku}",
          "notes": "Disponibilité temps réel par entrepôt"
        },
        {
          "method": "POST",
          "path": "/orders",
          "notes": "Création de commande, idempotency-key requise"
        },
        {
          "method": "GET",
          "path": "/orders/{id}",
          "notes": "Suivi du statut de commande"
        },
        {
          "method": "GET",
          "path": "/invoices",
          "notes": "Factures du client connecté"
        }
      ],
      "notes": "Système central, rate limit 60 req/min, fenêtre de maintenance dimanche 02h-04h. Point de défaillance critique."
    },
    {
      "id": "d5b414d7-aeda-463b-a306-ab98c920ebd9",
      "name": "Auth SSO (Keycloak)",
      "baseUrl": "https://sso.acme-b2b.com/realms/b2b",
      "auth": "OIDC / OAuth2 Authorization Code + PKCE",
      "risk": "medium",
      "endpoints": [
        {
          "method": "POST",
          "path": "/protocol/openid-connect/token",
          "notes": "Échange code → jetons access/refresh"
        },
        {
          "method": "GET",
          "path": "/protocol/openid-connect/userinfo",
          "notes": "Profil et rôles de l'utilisateur"
        },
        {
          "method": "POST",
          "path": "/protocol/openid-connect/logout",
          "notes": "Déconnexion globale (back-channel)"
        }
      ],
      "notes": "Realm b2b, rôles : client, acheteur, admin-compte. Refresh token 30 min."
    },
    {
      "id": "5b8f8d19-240d-4923-947c-f5cd1d67c71f",
      "name": "Paiement (Stripe)",
      "baseUrl": "https://api.stripe.com/v1",
      "auth": "Bearer secret key (côté serveur uniquement)",
      "risk": "high",
      "endpoints": [
        {
          "method": "POST",
          "path": "/payment_intents",
          "notes": "Création d'une intention de paiement (3DS)"
        },
        {
          "method": "GET",
          "path": "/payment_intents/{id}",
          "notes": "Statut du paiement"
        },
        {
          "method": "POST",
          "path": "/refunds",
          "notes": "Remboursement total ou partiel"
        }
      ],
      "notes": "PCI-DSS : aucune donnée carte ne transite par nos serveurs (Stripe Elements). Webhooks signés."
    }
  ],
